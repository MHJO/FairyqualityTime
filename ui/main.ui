  <property name="windowTitle">
   <string>퇴근요정 - 개인 업무 지원 및 일정 관리 시스템</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    /* 전체 배경 */
    QMainWindow {
     background-color: #f1f5f9;
    }

    /* 메뉴바 및 상태바 */
    QMenuBar {
     background-color: #ffffff;
     border-bottom: 1px solid #e2e8f0;
     font-size: 13px;
     color: #334155;
     padding: 2px 8px;
    }
    QMenuBar::item {
     background: transparent;
     padding: 6px 12px;
     border-radius: 4px;
    }
    QMenuBar::item:selected {
     background-color: #f1f5f9;
    }
    QMenu {
     background-color: #ffffff;
     border: 1px solid #cbd5e1;
     border-radius: 6px;
     padding: 4px;
    }
    QMenu::item {
     padding: 6px 24px;
     border-radius: 4px;
    }
    QMenu::item:selected {
     background-color: #2563eb;
     color: #ffffff;
    }
    QStatusBar {
     background-color: #ffffff;
     border-top: 1px solid #e2e8f0;
     color: #64748b;
     font-size: 12px;
    }

    /* 상단 타이틀(홈) 버튼 */
    QPushButton#btn_home {
     font-size: 18px;
     font-weight: bold;
     color: #0f172a;
     text-align: left;
     padding: 4px 8px;
     border: none;
     background: transparent;
    }

    /* 서브 타이틀 라벨 */
    QLabel#lbl_subtitle {
     font-size: 13px;
     color: #64748b;
     padding-left: 10px;
    }

    /* 그룹박스 및 프레임 스타일 */
    QGroupBox {
     font-weight: bold;
     font-size: 14px;
     color: #1e293b;
     border: 1px solid #cbd5e1;
     border-radius: 12px;
     background-color: #ffffff;
     margin-top: 12px;
     padding-top: 12px;
    }
    QGroupBox::title {
     subcontrol-origin: margin;
     subcontrol-position: top left;
     padding: 0 8px;
    }

    /* 메인 도구 버튼 (btn_1: 나라장터) */
    QPushButton#btn_1 {
     background-color: #2563eb;
     color: #ffffff;
     font-size: 15px;
     font-weight: bold;
     border-radius: 10px;
     border: none;
     padding: 14px;
    }
    QPushButton#btn_1:hover {
     background-color: #1d4ed8;
    }

    /* 보조 기능 버튼 (btn_4: 업무관리, btn_3: 엑셀뷰어) */
    QPushButton#btn_4, QPushButton#btn_3 {
     background-color: #ffffff;
     color: #1e293b;
     font-size: 14px;
     font-weight: 600;
     border-radius: 10px;
     border: 1px solid #cbd5e1;
     padding: 12px;
    }
    QPushButton#btn_4:hover, QPushButton#btn_3:hover {
     background-color: #f8fafc;
     border-color: #2563eb;
     color: #2563eb;
    }

    /* 캘린더 및 테이블 스타일 */
    QCalendarWidget QWidget {
     alternate-background-color: #f8fafc;
    }
    QTableWidget {
     background-color: #ffffff;
     border: 1px solid #cbd5e1;
     border-radius: 6px;
     gridline-color: #e2e8f0;
     font-size: 13px;
    }
    QHeaderView::section {
     background-color: #f8fafc;
     color: #475569;
     padding: 6px;
     border: none;
     border-bottom: 1px solid #cbd5e1;
     font-weight: bold;
    }
   </string>
