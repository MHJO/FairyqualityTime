QHeaderView::section { background: #f1f5f9; color: #475569; padding: 7px; border: 0; font-weight: 600; }
QLineEdit { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 7px; }
QPushButton { background: #ffffff; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; padding: 7px 12px; }
